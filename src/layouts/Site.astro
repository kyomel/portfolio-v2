---
import Base from "./Base.astro";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { label: "Work & Community", href: "/work/" },
  { label: "Contribute", href: "/contribute/" },
  { label: "About", href: "/about/" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<Base title={title} description={description}>
  <div class="page">
    <header class="masthead">
      <p class="who">
        <a href="/"><b>{profile.brand}</b></a>
        <span class="ref"> / {profile.location}</span>
      </p>
      <div class="masthead-right">
        <nav class="topnav" aria-label="Sections">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="nav-cta" href="/contact/">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch color theme">
          <span class="icons">
            <svg class="moon" viewBox="0 0 8 8" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" fill="currentColor"><rect x="2" y="0" width="3" height="1"/><rect x="1" y="1" width="2" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="0" y="3" width="2" height="1"/><rect x="0" y="4" width="2" height="1"/><rect x="1" y="5" width="1" height="1"/><rect x="1" y="6" width="2" height="1"/><rect x="2" y="7" width="3" height="1"/></svg>
            <svg class="sun" viewBox="0 0 8 8" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true" fill="currentColor"><rect x="3" y="0" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/><rect x="2" y="2" width="3" height="1"/><rect x="1" y="3" width="5" height="1"/><rect x="1" y="4" width="5" height="1"/><rect x="2" y="5" width="3" height="1"/><rect x="1" y="6" width="1" height="1"/><rect x="5" y="6" width="1" height="1"/><rect x="3" y="7" width="1" height="1"/></svg>
          </span>
        </button>
      </div>
    </header>

    <slot />

    <div class="horizon" aria-hidden="true">
      <span class="star" style="left: 8%; top: 26%"></span>
      <span class="star" style="left: 21%; top: 44%; opacity: 0.4"></span>
      <span class="star" style="left: 36%; top: 20%; opacity: 0.5"></span>
      <span class="star" style="left: 52%; top: 38%; opacity: 0.35"></span>
      <span class="star" style="left: 66%; top: 24%; opacity: 0.45"></span>
      <span class="star" style="left: 81%; top: 46%; opacity: 0.35"></span>
      <span class="star" style="left: 92%; top: 28%; opacity: 0.4"></span>
      <span class="moon"></span>
      <span class="seigaiha"></span>
    </div>

    <footer class="footer">
      <span>(c) {new Date().getFullYear()} {profile.brand}</span>
      <span>Astro, static, no framework shipped to the browser</span>
      <button class="motion-toggle" type="button" aria-pressed="true">
        motion: on
      </button>
    </footer>
  </div>

  <script>
    const root = document.documentElement;
    const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    type VTDocument = Document & {
      startViewTransition?: (cb: () => void) => { ready: Promise<void> };
    };

    btn?.addEventListener("click", (e) => {
      const dark =
        root.dataset.theme === "dark" ||
        (root.dataset.theme !== "light" &&
          matchMedia("(prefers-color-scheme: dark)").matches);
      const next = dark ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      };
      const doc = document as VTDocument;
      if (reducedMotion.matches || !doc.startViewTransition) {
        apply();
        return;
      }
      const rect = btn.getBoundingClientRect();
      const x = e.clientX || rect.left + rect.width / 2;
      const y = e.clientY || rect.top + rect.height / 2;
      const vt = doc.startViewTransition(apply);
      vt.ready
        .then(() => {
          const r = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y),
          );
          root.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${r}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 480,
              easing: "cubic-bezier(.16,1,.3,1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        })
        .catch(() => {});
    });

    // footer motion switch: freezes CSS animation; survives reload
    const motionBtn = document.querySelector<HTMLButtonElement>(".motion-toggle");
    const setMotion = (on: boolean) => {
      if (on) delete root.dataset.motion;
      else root.dataset.motion = "off";
      localStorage.setItem("motion", on ? "on" : "off");
      motionBtn?.setAttribute("aria-pressed", String(on));
      if (motionBtn) motionBtn.textContent = `motion: ${on ? "on" : "off"}`;
    };
    if (motionBtn && root.dataset.motion === "off") {
      motionBtn.setAttribute("aria-pressed", "false");
      motionBtn.textContent = "motion: off";
    }
    motionBtn?.addEventListener("click", () => {
      setMotion(root.dataset.motion === "off");
    });

    // stepped count-up; the final value stays in the DOM for no-JS and reduced motion
    const counted = new WeakSet<Element>();
    const numObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || counted.has(entry.target)) continue;
          counted.add(entry.target);
          const el = entry.target as HTMLElement;
          const to = Number(el.dataset.to);
          if (!Number.isFinite(to)) continue;
          if (reducedMotion.matches || root.dataset.motion === "off") continue;
          let i = 0;
          el.textContent = "0";
          const tick = setInterval(() => {
            i += 1;
            el.textContent = String(Math.round((to * i) / 7));
            if (i >= 7) clearInterval(tick);
          }, 130);
        }
      },
      { threshold: 0.6 },
    );
    document
      .querySelectorAll<HTMLElement>(".facts .num")
      .forEach((el) => numObserver.observe(el));
  </script>
</Base>
