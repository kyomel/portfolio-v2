---
import Site from "../layouts/Site.astro";
import PixelPortrait from "../components/PixelPortrait.astro";
import PixelSprite from "../components/PixelSprite.astro";
import PixelLamp from "../components/PixelLamp.astro";
import photo from "../assets/kyomel_anime_v4.png";
import { profile } from "../data/profile";
import { buildFacts, metrics, records } from "../data/evidence";
import { caseStudies } from "../data/work";
import { totals } from "../data/contributions";

const facts = buildFacts();

const lanes = [
  {
    n: "01",
    k: "Build & Grow",
    href: "/work/",
    d: "Case studies, the full role list, and the community programs behind them.",
    c: `${caseStudies.length} case studies, ${records.length} roles`,
  },
  {
    n: "02",
    k: "Contribute",
    href: "/contribute/",
    d: "Open source work and the repositories I maintain for the community.",
    c: `${totals.merged} merged pull requests`,
  },
];
---

<Site title={profile.brand} description={profile.tagline}>
  <section class="section" id="top">
    <p class="label"><b>01</b> Summary</p>
    <div class="body">
      <h1 class="headline">{profile.headline}</h1>
      <p class="lead">{profile.tagline}</p>
      <div class="facts">
        {
          metrics.map((m) => (
            <div class="fact reveal">
              <span class="n">
                <span class="num" data-to={m.value}>{m.value}</span>
                {m.unit && <i>{m.unit}</i>}
              </span>
              <span class="k">{m.label}</span>
              <span class="note">{m.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="lanes">
    <p class="label"><b>02</b> Sections</p>
    <div class="body">
      <div class="lanes">
        {
          lanes.map((l) => (
            <a class="lane reveal" href={l.href}>
              <span class="n">{l.n}</span>
              <span class="k">{l.k}</span>
              <span class="d">{l.d}</span>
              <span class="c">{l.c}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="proof">
    <p class="label"><b>03</b> Proof</p>
    <div class="body">
      <div class="plate">
        <figure class="plate-figure">
          <div class="plate-slot" data-px-host>
            <PixelPortrait
              src={photo}
              alt={`${profile.name} portrait`}
              block={4}
              class="pp-warm"
            />
            <PixelLamp class="plate-lamp" block={4} />
            <PixelSprite class="plate-bot" size="md" />
            <span class="mote" style="left: 10%; top: 68%; --dx: 24px; --dy: -58px; animation-duration: 23s; animation-delay: -3s"></span>
            <span class="mote" style="left: 26%; top: 82%; --dx: -18px; --dy: -74px; animation-duration: 27s; animation-delay: -9s"></span>
            <span class="mote" style="left: 44%; top: 58%; --dx: 20px; --dy: -48px; animation-duration: 25s; animation-delay: -16s"></span>
            <span class="mote" style="left: 62%; top: 86%; --dx: -22px; --dy: -66px; animation-duration: 29s; animation-delay: -6s"></span>
            <span class="mote" style="left: 78%; top: 64%; --dx: 16px; --dy: -52px; animation-duration: 24s; animation-delay: -20s"></span>
            <span class="mote" style="left: 90%; top: 78%; --dx: -24px; --dy: -70px; animation-duration: 28s; animation-delay: -12s"></span>
          </div>
          <figcaption class="plate-caption">
            <span>Plate 01 - portrait</span>
            <span>Lamp on - tap to sharpen</span>
          </figcaption>
        </figure>
        <div>
          <h3 class="sub">This page, measured at build time</h3>
          <dl class="derived">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>
                    {f.value}
                    {f.detail && <small>{f.detail}</small>}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <p class="label"><b>04</b> Contact</p>
    <div class="body">
      <div class="contact-band">
        <div>
          <h3 class="sub">Get in touch</h3>
          <p class="lead">
            Open to conversations about software engineering, Web3, AI, and
            mentoring.
          </p>
        </div>
        <a class="btn btn-primary" href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>
</Site>
