---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm";
import { profile } from "../data/profile";
import photo from "../assets/kyomel_anime_v4.png";

const nameWords = profile.name.split(" ");
let chIndex = 0;
const navItems = [
  { n: "01", label: "About", href: "#about" },
  { n: "02", label: "Resume", href: "#resume" },
  { n: "03", label: "Work", href: "#work" },
  { n: "04", label: "Contact", href: "#contact" },
];
---

<Base title="KyoMel" description={profile.tagline}>
  <div class="shell" id="top">
    <aside class="rail">
      <div class="rail-top">
        <a class="brand" href="#top">KyoMel</a>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
        >
          <svg
            class="sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
          </svg>
        </button>
      </div>

      <div class="rail-body">
        <Image
          class="rail-photo"
          src={photo}
          alt={`${profile.name} profile photo`}
          width={600}
          height={800}
        />
        <p class="eyebrow rail-hello">Hello, I'm</p>
        <h1 class="rail-name" aria-label={profile.name}>
          {
            nameWords.map((w) => (
              <span class="word" aria-hidden="true">
                {[...w].map((c) => (
                  <span class="ch" style={`--i:${chIndex++}`}>
                    {c}
                  </span>
                ))}
              </span>
            ))
          }
        </h1>
        <p class="roles">
          <span class="sr-only">{profile.roles}</span>
          <span data-scramble aria-hidden="true">{profile.roles}</span>
        </p>
        <p class="tagline">{profile.tagline}</p>

        <nav class="rail-nav" aria-label="Sections">
          {
            navItems.map((item) => (
              <a href={item.href}>
                <span class="n">{item.n}</span>
                <span class="t">{item.label}</span>
              </a>
            ))
          }
        </nav>
        <a class="rail-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="socials">
          {
            profile.socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </aside>

    <main class="main">
      <section id="about">
        <div class="wrap">
          <p class="eyebrow">01 / About</p>
          <h2>Software Engineer based in Yogyakarta</h2>
          <div class="stats">
            {
              profile.stats.map((s) => (
                <div class="stat">
                  <span class="stat-value">{s.value}</span>
                  <span class="stat-label">{s.label}</span>
                </div>
              ))
            }
          </div>
          <div class="about-grid">
            <dl class="details">
              {
                profile.details.map((d) => (
                  <div>
                    <dt>{d.label}</dt>
                    <dd>{d.value}</dd>
                  </div>
                ))
              }
            </dl>
            <div>
              {profile.about.map((p) => <p class="reveal">{p}</p>)}
              <p class="eyebrow" style="margin-top: 28px">Tech Stack</p>
              <ul class="tags">
                {profile.stack.map((s) => <li class="tag">{s}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="resume">
        <div class="wrap">
          <p class="eyebrow">02 / Resume</p>
          <h2>Experience & Education</h2>
          <h3 style="margin-top: 40px">Experience</h3>
          <div class="timeline">
            {
              profile.experience.map((e, i) => (
                <div class="entry reveal">
                  <span class="idx" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div class="period">{e.period}</div>
                  <div>
                    <h4>{e.company}</h4>
                    <p>{e.role}</p>
                    <p>{e.place}</p>
                    {e.highlights && (
                      <ul class="highlights">
                        {e.highlights.map((h) => (
                          <li>{h}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
          <h3 style="margin-top: 48px">Education</h3>
          <div class="timeline">
            {
              profile.education.map((e, i) => (
                <div class="entry reveal">
                  <span class="idx" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div class="period">{e.period}</div>
                  <div>
                    <h4>{e.school}</h4>
                    <p>{e.degree}</p>
                    <p>{e.place}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <h3 style="margin-top: 48px">Licenses & Certifications</h3>
          <div class="cert-pointer reveal">
            <p>{profile.certificationsNote}</p>
            <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
              View All on LinkedIn
            </a>
          </div>
        </div>
      </section>

      <section id="work">
        <div class="wrap">
          <p class="eyebrow">03 / Portfolio</p>
          <h2>Featured Projects</h2>
          <div class="projects" style="margin-top: 32px">
            {
              profile.projects.map((p) => (
                <article class="card reveal">
                  <span class="category">{p.category}</span>
                  <h3>{p.title}</h3>
                  <p>{p.desc}</p>
                  <ul class="tags">
                    {p.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="wrap">
          <p class="eyebrow">04 / Contact</p>
          <h2>Let's build something together.</h2>
          <div class="contact-grid">
            <div>
              <p class="muted">
                I'm always open to discussing new projects, creative ideas, or
                opportunities to be part of your visions.
              </p>
              <div class="contact-info">
                <span>{profile.location}</span>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
                <div class="contact-socials">
                  {
                    profile.socials.map((s) => (
                      <a href={s.url} target="_blank" rel="noopener">
                        {s.label} ↗
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
            <ContactForm client:load />
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <div class="wrap">
          © {new Date().getFullYear()} {profile.name}
        </div>
      </footer>
    </main>
  </div>

  <script>
    const root = document.documentElement;
    const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    type VTDocument = Document & {
      startViewTransition?: (cb: () => void) => { ready: Promise<void> };
    };

    btn?.addEventListener("click", (e) => {
      const dark =
        root.dataset.theme === "dark" ||
        (root.dataset.theme !== "light" &&
          matchMedia("(prefers-color-scheme: dark)").matches);
      const next = dark ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      };
      const doc = document as VTDocument;
      if (reducedMotion.matches || !doc.startViewTransition) {
        apply();
        return;
      }
      const rect = btn.getBoundingClientRect();
      const x = e.clientX || rect.left + rect.width / 2;
      const y = e.clientY || rect.top + rect.height / 2;
      const vt = doc.startViewTransition(apply);
      vt.ready
        .then(() => {
          const r = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y),
          );
          root.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${r}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 480,
              easing: "cubic-bezier(.16,1,.3,1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        })
        .catch(() => {});
    });

    const rolesEl = document.querySelector<HTMLElement>("[data-scramble]");
    if (rolesEl && !reducedMotion.matches) {
      const roles = (rolesEl.textContent ?? "")
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
      const glyphs =
        "ABCDEFGHKLMNPQRSTUVWXYZabcdefghkmnpqrstuvwxyz23456789";
      const paint = (target: string, done: number) => {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          const c = target.charAt(i);
          out +=
            i < done || c === " "
              ? c
              : glyphs.charAt((Math.random() * glyphs.length) | 0);
        }
        rolesEl.textContent = out;
      };
      const scrambleIn = (target: string) =>
        new Promise<void>((resolve) => {
          let f = -10;
          const step = () => {
            f += 2;
            paint(target, f);
            if (f < target.length) requestAnimationFrame(step);
            else resolve();
          };
          requestAnimationFrame(step);
        });
      const cycle = async () => {
        let idx = 0;
        for (;;) {
          await scrambleIn(roles[idx]);
          await new Promise((r) => setTimeout(r, 2400));
          idx = (idx + 1) % roles.length;
        }
      };
      if (roles.length) cycle();
    }
  </script>
</Base>
