---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
}
const { src, alt, width = 600, height = 800 } = Astro.props;
---

{/*
  Pixel avatar. Grid: one 3px block, so about 50x66 cells at 148x197
  (tested 48/60/72 cols: 72 reads as a blurry photo, 48-50 keeps the
  face and stays clearly "pixel"). Colors are median-cut to 24.
*/}
<div class="pp-wrap" tabindex="0">
  <Image
    class="rail-photo pp-img"
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="eager"
    fetchpriority="high"
  />
  <canvas class="pp-canvas" aria-hidden="true"></canvas>
</div>

<script>
  const BLOCK = 3; // css px, the only block size
  const COLORS = 24;
  const TICK = 25; // ms
  const TICKS = 44; // 44 * 25ms = 1.1s

  const wrap = document.querySelector<HTMLElement>(".pp-wrap")!;
  const img = wrap.querySelector<HTMLImageElement>(".pp-img")!;
  const cv = wrap.querySelector<HTMLCanvasElement>(".pp-canvas")!;
  const ctx = cv.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let cols = 0,
    rows = 0,
    bd = 0,
    colors: string[] = [],
    order: number[] = [],
    shown = 0,
    raf = 0,
    t0 = 0,
    started = false;

  // Median cut: split the box with the widest channel range at its median.
  function quantize(px: Uint8ClampedArray): string[] {
    const n = px.length / 4;
    let boxes: number[][] = [Array.from({ length: n }, (_, i) => i)];
    const spread = (b: number[]) => {
      let best = 0,
        ch = 0;
      for (let c = 0; c < 3; c++) {
        let lo = 255,
          hi = 0;
        for (const i of b) {
          const v = px[i * 4 + c];
          if (v < lo) lo = v;
          if (v > hi) hi = v;
        }
        if (hi - lo > best) ((best = hi - lo), (ch = c));
      }
      return { best, ch };
    };
    while (boxes.length < COLORS) {
      let bi = -1,
        bs = 0,
        bc = 0;
      boxes.forEach((b, k) => {
        if (b.length < 2) return;
        const { best, ch } = spread(b);
        const score = best * Math.sqrt(b.length);
        if (score > bs) ((bs = score), (bi = k), (bc = ch));
      });
      if (bi < 0) break;
      const b = boxes[bi].sort((a, z) => px[a * 4 + bc] - px[z * 4 + bc]);
      const m = b.length >> 1;
      boxes.splice(bi, 1, b.slice(0, m), b.slice(m));
    }
    const out: string[] = new Array(n);
    for (const b of boxes) {
      const s = [0, 0, 0];
      for (const i of b) for (let c = 0; c < 3; c++) s[c] += px[i * 4 + c];
      const col = `rgb(${s.map((v) => Math.round(v / b.length)).join(",")})`;
      for (const i of b) out[i] = col;
    }
    return out;
  }

  // Halve repeatedly so the downscale is a clean area average.
  function sample(w: number, h: number): Uint8ClampedArray {
    let src: CanvasImageSource = img;
    let sw = img.naturalWidth,
      sh = img.naturalHeight;
    while (sw / 2 > w * 1.5) {
      const c = document.createElement("canvas");
      c.width = sw = Math.round(sw / 2);
      c.height = sh = Math.round(sh / 2);
      const g = c.getContext("2d")!;
      g.imageSmoothingQuality = "high";
      g.drawImage(src, 0, 0, sw, sh);
      src = c;
    }
    const c = document.createElement("canvas");
    c.width = w;
    c.height = h;
    const g = c.getContext("2d", { willReadFrequently: true })!;
    g.imageSmoothingQuality = "high";
    g.drawImage(src, 0, 0, w, h);
    const d = g.getImageData(0, 0, w, h);
    sharpen(d.data, w, h);
    return d.data;
  }

  // Light unsharp mask on the grid so eyes and brows survive the downscale.
  function sharpen(px: Uint8ClampedArray, w: number, h: number) {
    const o = px.slice();
    const at = (x: number, y: number, c: number) =>
      o[(Math.min(h - 1, Math.max(0, y)) * w + Math.min(w - 1, Math.max(0, x))) * 4 + c];
    for (let y = 0; y < h; y++)
      for (let x = 0; x < w; x++)
        for (let c = 0; c < 3; c++) {
          const blur = (at(x - 1, y, c) + at(x + 1, y, c) + at(x, y - 1, c) + at(x, y + 1, c)) / 4;
          px[(y * w + x) * 4 + c] = o[(y * w + x) * 4 + c] * 1.9 - blur * 0.9;
        }
  }

  function paint(from: number, to: number) {
    for (let k = from; k < to; k++) {
      const i = order[k];
      ctx.fillStyle = colors[i];
      ctx.fillRect((i % cols) * bd, ((i / cols) | 0) * bd, bd, bd);
    }
  }

  function layout() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const w = wrap.clientWidth,
      h = wrap.clientHeight;
    bd = Math.round(BLOCK * dpr);
    const nc = Math.ceil(w / BLOCK),
      nr = Math.ceil(h / BLOCK);
    cv.width = Math.round(w * dpr);
    cv.height = Math.round(h * dpr);
    cv.style.width = cv.width / dpr + "px";
    cv.style.height = cv.height / dpr + "px";
    ctx.imageSmoothingEnabled = false;
    if (nc !== cols || nr !== rows) {
      cols = nc;
      rows = nr;
      colors = quantize(sample(cols, rows));
      // Seeded shuffle: same assembly order on every load.
      let s = 7;
      order = Array.from({ length: cols * rows }, (_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        s = (s * 1664525 + 1013904223) >>> 0;
        const j = s % (i + 1);
        [order[i], order[j]] = [order[j], order[i]];
      }
    }
    paint(0, shown);
  }

  function step(now: number) {
    const tick = Math.min(TICKS, Math.floor((now - t0) / TICK));
    const to = Math.ceil((order.length * tick) / TICKS);
    if (to > shown) {
      paint(shown, to);
      shown = to;
    }
    raf = shown < order.length ? requestAnimationFrame(step) : 0;
  }

  function start() {
    if (started) return;
    started = true;
    if (still) {
      shown = order.length;
      paint(0, shown);
    } else {
      raf = requestAnimationFrame((now) => ((t0 = now), step(now)));
    }
  }

  async function init() {
    await img.decode().catch(() => {});
    layout();
    new ResizeObserver(layout).observe(wrap);
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) (start(), io.disconnect());
    }).observe(wrap);
  }
  init();

  // Pause the assembly while the tab is hidden.
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) cancelAnimationFrame(raf);
    else if (started && shown < order.length) {
      t0 = performance.now() - (shown / order.length) * TICKS * TICK;
      raf = requestAnimationFrame(step);
    }
  });
</script>

<style is:global>
  .pp-wrap {
    position: relative;
    width: 148px;
    aspect-ratio: 3 / 4;
    flex: none;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
  }

  .pp-wrap .pp-img {
    display: block;
    width: 100%;
    height: 100%;
    animation: none;
    transition: opacity 220ms steps(4, end);
  }

  .pp-canvas {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    image-rendering: pixelated;
    transition: opacity 220ms steps(4, end);
  }

  /* inset ring, drawn above both layers */
  .pp-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent);
    pointer-events: none;
  }

  /* hide the sharp image only when JS can draw the pixel layer */
  @media (scripting: enabled) {
    .pp-wrap .pp-img {
      opacity: 0;
    }
  }

  .pp-wrap:hover .pp-img,
  .pp-wrap:focus-within .pp-img {
    opacity: 1;
  }

  .pp-wrap:hover .pp-canvas,
  .pp-wrap:focus-within .pp-canvas {
    opacity: 0;
  }

  .pp-wrap:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 899px) {
    .pp-wrap {
      width: 140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-wrap .pp-img,
    .pp-canvas {
      transition: none;
    }
  }
</style>
